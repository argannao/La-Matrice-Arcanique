rules_version = '2';

// Règles Firestore de La Matrice Arcanique
// Chaque utilisateur ne peut lire et écrire que ses propres sorts : users/{uid}/sorts/{id}
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/sorts/{sortId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasAll(['id', 'blocs'])
                            && request.resource.data.id == sortId
                            && request.resource.data.blocs is list
                            && request.resource.data.blocs.size() <= 200;
    }
    // Tout le reste est fermé
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
